# AutoJopps prototype v1 — copy to .env and fill in. Every key is optional:
# when a key is missing the prototype falls back to a demo mode so the demo never breaks.

# ---- App
APP_SECRET=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8000
APP_ENV=dev
DATABASE_URL=sqlite:///./autojopps.db

# ---- Google sign-in (OIDC). Create an OAuth client (Web application) in Google Cloud Console,
# add http://localhost:8000/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to 1 to also request Gmail read-only scope on "Connect Gmail" (works in Testing mode for
# test users you add in the OAuth consent screen; public use needs Google verification).
GOOGLE_GMAIL_SCOPE=0

# ---- Claude API (resume parsing, JD matching explanations, answer drafting).
# Without it: a heuristic parser and keyword matching are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Razorpay (test mode keys from the Razorpay dashboard). Without them: "Demo activate".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email alerts (SMTP). Without it: alerts are logged and shown in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AutoJopps <no-reply@example.com>

# ---- WhatsApp (Meta Cloud API). Without it: alerts are logged and shown in-app only.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=autojopps_hitl

# ---- Runner
RUNNER_HEADLESS=1
RUNNER_SLOWMO_MS=150
# Seconds between orchestrator ticks
ORCHESTRATOR_TICK_SECONDS=5
